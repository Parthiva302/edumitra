# ==============================================================================
# EDUMITRA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Database & Auth Configuration
# Obtain from your Supabase Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Gemini Model Overrides (Optional)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_VIDEO_MODEL=veo-2.0-generate-001

# Development Fallback Mode (Set to true to run deterministic mock AI without consuming quota)
USE_MOCK_AI=false

# Full-Stack Backend Proxy Configuration
FASTAPI_URL=http://127.0.0.1:8000
PORT=5173
